# Shadow Desktop — local single-user defaults.
# The launcher copies this to ../.env on a fresh checkout ONLY if no .env
# exists. An existing .env is never overwritten. Add provider keys as needed.

# Bind the app to loopback only (the desktop window is the sole client).
APP_BIND=127.0.0.1
APP_PORT=7000

# Native cookie auth (create your local account on first launch). Cookies are
# not marked Secure because the desktop connects over plain http://127.0.0.1.
AUTH_ENABLED=true
SECURE_COOKIES=false
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Reach a model server running on the host machine (outside the container).
# For Ollama on the host, leave LLM_HOST as-is and set OLLAMA_BASE_URL.
LLM_HOST=host.docker.internal
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OPENAI_API_KEY=

# The container drops to this uid/gid so bind-mounted ./data stays editable.
# Match your host user:  Linux/macOS -> run `id -u` / `id -g`.  Windows -> 1000.
PUID=1000
PGID=1000
