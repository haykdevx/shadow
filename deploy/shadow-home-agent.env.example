# Bind the exact home PC Tailscale address. Do not use 0.0.0.0.
SHADOW_HOME_AGENT_BIND=100.x.y.z
SHADOW_HOME_AGENT_PORT=8765
# For same-host Docker, set an absolute host path instead of exposing TCP.
# SHADOW_HOME_AGENT_SOCKET=/home/YOUR_USER/shadow/data/shadow-home-agent.sock
SHADOW_HOME_AGENT_TOKEN=replace_with_output_of_openssl_rand_hex_32

# Application launching is label-based. No arbitrary shell command is exposed.
SHADOW_ALLOWED_APPS=terminal=gnome-terminal,browser=firefox

