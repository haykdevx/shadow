shadow.example.com {
    encode zstd gzip

    # MeshCentral stays loopback-only and is exposed under Shadow's same origin.
    # Caddy handles WebSocket upgrades automatically.
    handle /remote/* {
        reverse_proxy https://127.0.0.1:8443 {
            transport http {
                tls_insecure_skip_verify
            }
        }
    }

    handle {
        reverse_proxy 127.0.0.1:7000
    }
}
